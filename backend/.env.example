# N3M Downloader engine — example environment.
# Copy to backend/.env, or let backend/bootstrap.py create it with random secrets.

N3M_ENV=development

# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
TICKET_SECRET=

# Comma-separated browser origins allowed to call the API.
TRUSTED_ORIGINS=https://n3m.fun,https://www.n3m.fun,http://localhost:3000,http://127.0.0.1:3000

# Rate limiting (per IP, sliding 60s window).
INSPECT_RATE_PER_MIN=30
DOWNLOAD_RATE_PER_MIN=6
ADMIN_RATE_PER_MIN=60

# Jobs and storage.
MAX_CONCURRENT_JOBS=2
MAX_QUEUED_JOBS=20
JOB_TIMEOUT_SECONDS=1800
JOB_RETENTION_MINUTES=120
MIN_FREE_GB=2
MAX_FILESIZE_MB=2048
TICKET_TTL_SECONDS=300
REQUEST_TIMEOUT_SECONDS=20

# Set false only behind a proxy you do not control the headers of.
TRUST_PROXY_HEADERS=true

# Optional explicit binary paths.
# YTDLP_BIN=
# GALLERYDL_BIN=
# ARIA2C_BIN=aria2c
# FFMPEG_BIN=ffmpeg
# N3M_WORK_DIR=.work

# YouTube datacenter bot check: base64 Netscape cookie file for youtube.com.
# YOUTUBE_COOKIES_B64=
# YouTube player clients to try (comma separated).
# YTDLP_PLAYER_CLIENT=tv,mweb
# Optional SOCKS/HTTP proxy for YouTube only (WARP is enabled in Docker).
# YTDLP_PROXY=socks5://127.0.0.1:8086
