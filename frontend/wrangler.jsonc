{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "n3m-downloader",
  "main": "worker/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "n3m.fun/downloader", "zone_name": "n3m.fun" },
    { "pattern": "n3m.fun/downloader/*", "zone_name": "n3m.fun" }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
